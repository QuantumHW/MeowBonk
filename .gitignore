# 默认忽略所有文件，仅放行公开源码、构建配置、测试和运行素材。
# 新增文件须确认适合公开后，再按需要补充规则。
*

!/.gitignore
!/README.md
!/LICENSE
!/package.json
!/package-lock.json
!/index.html
!/tsconfig.json
!/vite.config.ts
!/.npmrc

!/.github/
!/.github/workflows/
!/.github/workflows/installers.yml

!/.cargo/
!/.cargo/config.toml

!/src/
!/src/**/
!/src/**/*.ts
!/src/**/*.tsx
!/src/**/*.css

!/public/
!/public/app-logo.png
!/public/cat-standing.png

!/scripts/
!/scripts/env.mjs
!/scripts/cargo.mjs
!/scripts/tauri.mjs
!/scripts/mac-dev-sign.mjs

!/src-tauri/
!/src-tauri/Cargo.toml
!/src-tauri/Cargo.lock
!/src-tauri/tauri.conf.json
!/src-tauri/build.rs
!/src-tauri/src/
!/src-tauri/src/**/
!/src-tauri/src/**/*.rs
!/src-tauri/src/platform/target.m
!/src-tauri/capabilities/
!/src-tauri/capabilities/overlay.json
!/src-tauri/capabilities/settings.json
!/src-tauri/icons/
!/src-tauri/icons/icon.png
!/src-tauri/icons/icon.icns

!/tests/
!/tests/*.test.mjs

# 在源码目录内也始终忽略本地工具、缓存和编辑器数据。
**/node_modules/
**/target/
**/dist/
**/.cache/
**/.agents/
**/.codex/
**/.idea/
**/.vscode/
**/.DS_Store
